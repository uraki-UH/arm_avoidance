<?xml version="1.0"?>
<robot name="topo_dual_arm_max">

  <!-- Color policy: outer covers are green; frames, servos, and housings use
       the matte charcoal-black of the DYNAMIXEL units. -->
  <material name="black">  <color rgba="0.14 0.15 0.145 1.0"/></material>
  <material name="green">  <color rgba="0.01 0.88 0.05 1.0"/></material>
  <material name="gray">   <color rgba="0.30 0.32 0.32 1.0"/></material>
  <material name="silver"> <color rgba="0.72 0.74 0.75 1.0"/></material>
  <material name="glass">  <color rgba="0.12 0.16 0.17 0.22"/></material>
  <material name="orange"> <color rgba="0.95 0.55 0.10 1.0"/></material>
  <material name="blue">   <color rgba="0.10 0.30 0.85 1.0"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.013683" iyy="0.0137122" izz="0.00255217" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="base_footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="waist_cover_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/waist_cover.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="waist_cover_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="waist_cover_link"/>
    <!-- The lower face follows the base plate, shortened by 30 mm to Z=185 mm. -->
    <origin xyz="0 0 0.185" rpy="0 0 0"/>
  </joint>
  <link name="L_shoulder_cover_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/L_shoulder_cover.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="L_shoulder_cover_fixed" type="fixed">
    <parent link="torso_link"/>
    <child link="L_shoulder_cover_link"/>
    <!-- Upper-body coordinates; lowered 60 mm with the shortened torso. -->
    <origin xyz="0 0.025 0.15" rpy="0 0 0"/>
  </joint>
  <link name="R_shoulder_cover_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/shoulder_cover.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="R_shoulder_cover_fixed" type="fixed">
    <parent link="torso_link"/>
    <child link="R_shoulder_cover_link"/>
    <!-- Upper-body coordinates; lowered 60 mm with the shortened torso. -->
    <origin xyz="0 -0.025 0.15" rpy="0 0 0"/>
  </joint>
  <link name="torso_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/torso_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/torso_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="1.8"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0163086" iyy="0.0133106" izz="0.00526875" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="waist_joint" type="continuous">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <!-- Waist axis lowered 30 mm with the shortened base. -->
    <origin xyz="0 0 0.2315" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="2"/>
  </joint>
  <!-- STEP由来の胸部MID-360。機械取付フレーム、計測原点・IMU原点は未校正。 -->
  <link name="chest_lidar_mount_link">
    <collision>
      <geometry><mesh filename="meshes/chest_lidar_mount_45.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/chest_lidar_mount_45.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="green" />
    </visual>
  </link>
  <joint name="chest_lidar_mount_fixed" type="fixed">
    <parent link="torso_link"/>
    <child link="chest_lidar_mount_link"/>
    <origin xyz="0.028 0 0.102521097973" rpy="0 0 0"/>
  </joint>
  <link name="chest_lidar_link">
    <!-- STEP面色のlinear RGB値 -->
    <collision>
      <origin xyz="0 -0.003931539599 0.004131449852"/>
      <geometry><box size="0.065033845603 0.072896927595 0.060257099569"/></geometry>
    </collision>

    <visual name="chest_lidar_cad_blue">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/chest_lidar_color_0.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="chest_lidar_cad_blue">
        <color rgba="0.005605392 0.000303527 0.309468925 1" />
      </material>
    </visual>
    <visual name="chest_lidar_cad_gray">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/chest_lidar_color_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="chest_lidar_cad_gray">
        <color rgba="0.351532608 0.351532608 0.351532608 1" />
      </material>
    </visual>
    <visual name="chest_lidar_cad_silver">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/chest_lidar_color_2.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="chest_lidar_cad_silver">
        <color rgba="0.715693474 0.715693474 0.715693474 1" />
      </material>
    </visual>
    <visual name="chest_lidar_cad_pale_blue">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/chest_lidar_color_3.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="chest_lidar_cad_pale_blue">
        <color rgba="0.745404184 0.887923121 1 1" />
      </material>
    </visual>
  </link>
  <joint name="chest_lidar_fixed" type="fixed">
    <parent link="chest_lidar_mount_link"/>
    <child link="chest_lidar_link"/>
    <origin xyz="0.041326157159 0 0.018326157159" rpy="0 0.785398163397 0"/>
  </joint>
  <link name="neck_pan_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/neck_pan_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/neck_pan_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="2.45017e-05" iyy="2.75391e-05" izz="3.30001e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="neck_pan_joint" type="continuous">
    <parent link="torso_link"/>
    <child link="neck_pan_link"/>
    <!-- Neck axis lowered 60 mm with the shortened torso. -->
    <origin xyz="0 0 0.2205" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="3" velocity="3"/>
  </joint>
  <link name="neck_tilt_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/camera_link.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/neck_tilt_link.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="4.04167e-05" iyy="1.72417e-05" izz="4.72417e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="neck_tilt_joint" type="revolute">
    <parent link="neck_pan_link"/>
    <child link="neck_tilt_link"/>
    <origin xyz="0.024 0 0.0195" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.570796327" upper="2.007128640" effort="3" velocity="3"/>
  </joint>
  <link name="neck_tilt_cover_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/joint_cover_cut.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="neck_tilt_cover_fixed" type="fixed">
    <parent link="neck_pan_link"/>
    <child link="neck_tilt_cover_link"/>
    <!-- Fixed to the preceding link at the neck tilt joint origin. -->
    <origin xyz="0.024 0 0.0195" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/realsense_camera.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="silver"><color rgba="0.72 0.74 0.75 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/realsense_camera.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="3.63542e-05" iyy="5.20833e-06" izz="3.63542e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="camera_fixed" type="fixed">
    <parent link="neck_tilt_link"/>
    <child link="camera_link"/>
    <!-- Original STL orientation, shifted 1.5 mm along +X. -->
    <origin xyz="0.05775 0 0" rpy="0 0 0"/>
  </joint>
  <link name="realsense_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/realsense_mount.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="realsense_mount_fixed" type="fixed">
    <parent link="neck_tilt_link"/>
    <child link="realsense_mount_link"/>
    <!-- Shifted 1.5 mm forward together with the camera. -->
    <origin xyz="0.0295 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_fixed" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ===== LEFT ARM ===== -->
  <link name="L_shoulder_mount"/>
  <joint name="L_shoulder_mount_fixed" type="fixed">
    <parent link="torso_link"/>
    <child link="L_shoulder_mount"/>
    <origin xyz="0 0.0715 0.15" rpy="0 0 0"/>
  </joint>
  <link name="L_link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/L_link1.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/L_link1.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.165"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000160346" iyy="9.37308e-05" izz="0.000161663" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="L_joint1" type="continuous">
    <parent link="L_shoulder_mount"/>
    <child link="L_link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="6" velocity="3"/>
  </joint>
  <link name="L_XM540_cover_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/XM540_cover.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="L_XM540_cover_fixed" type="fixed">
    <parent link="L_link1"/>
    <child link="L_XM540_cover_link"/>
    <!-- Fixed to the preceding link at the L_joint2 origin. -->
    <origin xyz="0 0.06725 0" rpy="0 0 0"/>
  </joint>
  <link name="L_link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/L_link2.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/L_link2.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.165"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000128171" iyy="0.000159796" izz="6.24869e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="L_joint2" type="revolute">
    <parent link="L_link1"/>
    <child link="L_link2"/>
    <origin xyz="0 0.06725 0" rpy="1.570796327 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.007128640" upper="2.007128640" effort="6" velocity="3"/>
  </joint>
  <link name="L_link3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/L_link3.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/L_link3.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="9.84487e-05" iyy="0.000103469" izz="6.55127e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="L_joint3" type="continuous">
    <parent link="L_link2"/>
    <child link="L_link3"/>
    <origin xyz="0.0155 0 -0.0825" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="6" velocity="3"/>
  </joint>
  <link name="L_link4_cover_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/joint_cover.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="L_link4_cover_fixed" type="fixed">
    <parent link="L_link3"/>
    <child link="L_link4_cover_link"/>
    <!-- Fixed to the preceding link at the L_joint4 origin. -->
    <origin xyz="0 0 -0.068" rpy="0 0 0"/>
  </joint>
  <link name="L_link4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/L_link4.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/L_link4.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.082"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="4.60619e-05" iyy="4.91252e-05" izz="2.64874e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="L_joint4" type="revolute">
    <parent link="L_link3"/>
    <child link="L_link4"/>
    <origin xyz="0 0 -0.068" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.007128640" upper="1.658062789" effort="6" velocity="3"/>
  </joint>
  <link name="L_link5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/L_link5.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/collision/L_link5.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="7.28275e-05" iyy="7.68055e-05" izz="4.8922e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="L_joint5" type="continuous">
    <parent link="L_link4"/>
    <child link="L_link5"/>
    <origin xyz="0 0 -0.064" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="6" velocity="3"/>
  </joint>
  <link name="L_link6_cover_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/joint_cover.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="L_link6_cover_fixed" type="fixed">
    <parent link="L_link5"/>
    <child link="L_link6_cover_link"/>
    <!-- Fixed to the preceding link at the L_joint6 origin. -->
    <origin xyz="0 0 -0.0645" rpy="0 0 0"/>
  </joint>
  <link name="L_link6">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/L_link6.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/L_link6.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.082"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.80688e-05" iyy="9.09004e-06" izz="1.44454e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="L_joint6" type="revolute">
    <parent link="L_link5"/>
    <child link="L_link6"/>
    <origin xyz="0 0 -0.0645" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.007128640" upper="2.007128640" effort="6" velocity="3"/>
  </joint>
  <link name="L_link7">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/L_link7.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="black"><color rgba="0.14 0.15 0.145 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/L_link7.stl" scale="0.001 0.001 0.001"/></geometry>
    </collision>
    <inertial>
      <mass value="0.082"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="5.50592e-05" iyy="5.93877e-05" izz="2.52222e-05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="L_joint7" type="revolute">
    <parent link="L_link6"/>
    <child link="L_link7"/>
    <origin xyz="0 0 -0.06325" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.832595715" upper="1.832595715" effort="6" velocity="3"/>
  </joint>
  <link name="L_joint7_cover_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/visual/urdf/joint_cover.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="green"><color rgba="0.01 0.88 0.05 1.0"/></material>
    </visual>
  </link>
  <joint name="L_joint7_cover_fixed" type="fixed">
    <parent link="L_link6"/>
    <child link="L_joint7_cover_link"/>
    <!-- Rotate the cover's local Y axis onto the joint7 X axis. -->
    <origin xyz="0 0 -0.06325" rpy="0 0 -1.57079632679"/>
