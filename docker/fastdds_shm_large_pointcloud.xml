<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <!-- 別ホストとの通信経路とソケットバッファ -->
    <transport_descriptor>
      <transport_id>large_pointcloud_udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>16777216</sendBufferSize>
      <receiveBufferSize>16777216</receiveBufferSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>large_pointcloud_shm</transport_id>
      <type>SHM</type>
      <!-- 同一ホスト内の大容量点群配送用領域（32 MiB） -->
      <segment_size>33554432</segment_size>
      <port_queue_capacity>1024</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="large_pointcloud_shm_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>large_pointcloud_udp</transport_id>
        <transport_id>large_pointcloud_shm</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
