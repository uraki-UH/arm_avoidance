#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  printf '使用法: ros2 run ais_gng save_object_gng_dataset <dataset_id>\n' >&2
  exit 2
fi

dataset_id="$1"
if [[ ! "$dataset_id" =~ ^[[:alpha:]][[:alnum:]_]*$ ]]; then
  printf 'dataset_idは英字開始の英数字または_だけで指定してください: %s\n' "$dataset_id" >&2
  exit 2
fi

exec ros2 service call /save_object_gng_dataset ais_gng_msgs/srv/SaveObjectGngDataset \
  "{dataset_id: ${dataset_id}}"
