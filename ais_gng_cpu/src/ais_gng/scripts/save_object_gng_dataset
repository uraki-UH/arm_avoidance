#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  printf '使用法: ros2 run ais_gng save_object_gng_dataset <object_name>\n' >&2
  exit 2
fi

object_name="$1"
if [[ ! "$object_name" =~ ^[[:alpha:]][[:alnum:]_]*$ ]]; then
  printf 'object_nameは英字開始の英数字または_だけで指定してください: %s\n' "$object_name" >&2
  exit 2
fi

exec ros2 service call /save_gng_data ais_gng_msgs/srv/SaveObjectGngDataset \
  "{object_name: '${object_name}', output_dir: ''}"
