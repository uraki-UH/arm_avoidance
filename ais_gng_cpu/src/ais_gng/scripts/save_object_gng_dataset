#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
  printf '使用法: ros2 run ais_gng save_object_gng_dataset <object_name> [--with-points] [--replace]\n' >&2
  exit 2
fi

object_name="$1"
shift
if [[ ! "$object_name" =~ ^[[:alpha:]][[:alnum:]_]*$ ]]; then
  printf 'object_nameは英字開始の英数字または_だけで指定してください: %s\n' "$object_name" >&2
  exit 2
fi

enable_point_cloud_save=false
replace_existing=false
for option in "$@"; do
  case "$option" in
    --with-points)
      enable_point_cloud_save=true
      ;;
    --replace)
      replace_existing=true
      ;;
    *)
      printf '不明なオプション: %s\n' "$option" >&2
      exit 2
      ;;
  esac
done

exec ros2 service call /save_gng_data ais_gng_msgs/srv/SaveObjectGngDataset \
  "{object_name: '${object_name}', enable_point_cloud_save: ${enable_point_cloud_save}, replace_existing: ${replace_existing}, output_dir: ''}"
