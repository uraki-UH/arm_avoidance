<?xml version="1.0"?>
<sdf version="1.6">
  <world name="dual_arm_demo">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- 小慣性の指関節と有限トルクモータに対する拘束計算 -->
      <ode>
        <solver><type>quick</type><iters>200</iters><sor>1.0</sor></solver>
        <constraints><cfm>0.00000001</cfm><contact_max_correcting_vel>0.1</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry><material><ambient>0.55 0.55 0.55 1</ambient></material></visual>
      </link>
    </model>
    <model name="work_table">
      <static>true</static>
      <pose>0.70 0 0.20 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.35 0.8 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.35 0.8 0.4</size></box></geometry><material><ambient>0.3 0.35 0.45 1</ambient></material></visual>
      </link>
    </model>
    <gui><camera name="overview"><pose>1.4 -1.4 1.0 0 0.25 2.35</pose></camera></gui>
  </world>
</sdf>
