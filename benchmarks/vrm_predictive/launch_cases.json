{
  "cases": [
    {
      "name": "native_predictive",
      "cwd": "/ros2_ws/src",
      "env": {
        "ROS_DOMAIN_ID": "230",
        "ROS_LOCALHOST_ONLY": "1",
        "ROS2CLI_NO_DAEMON": "1",
        "TOPO_ROS_SETUP_READY": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "ROS_LOG_DIR": "/ros2_ws/src/log/artifacts/vrm_predictive/ros_logs",
        "OPENBLAS_NUM_THREADS": "1"
      },
      "argv": [
        "bash",
        "-c",
        "source /opt/ros/humble/setup.bash\nsource /ros2_ws/install/setup.bash\nexec python3 \"$@\"",
        "native_cli_check",
        "log/artifacts/vrm_predictive/launch_check.py",
        "--gng-strategy",
        "vrm_predictive",
        "--domain-id",
        "230",
        "--duration",
        "20",
        "--report-sec",
        "0.5",
        "--bag",
        "/rosbag/fuzzy/arm_avoidance/rosbag2_2026_10_09-22_01_23-20261012T015534Z-1-002/rosbag2_2026_10_09-22_01_23",
        "--output",
        "@case_dir@/state.jsonl"
