+  // 空の索引への連続要素の一括構築。反復子の参照対象は要素本体。
+  template <typename iter_type>
+  void build(iter_type first, iter_type last) {
+    if (total_elements_ != 0)
+      throw std::logic_error("一括構築には空の索引が必要です");
+    for (auto iter = first; iter != last; ++iter) {
+      auto *element = &*iter;
+      pushEntry(root_, element, Traits::getPosition(element));
+      ++total_elements_;
+    }
+    root_->count = total_elements_;
+    split(root_);
+  }
